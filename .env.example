# ============================================
# ADDS CRM — Variaveis de Ambiente (Exemplo)
# ============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ADDS CRM

# Tiny ERP (API V3 - OAuth)
TINY_CLIENT_ID=
TINY_CLIENT_SECRET=
# URL da API V3 OAuth (OBRIGATÓRIO: public-api/v3 — NÃO usar api3)
TINY_API_URL=https://api.tiny.com.br/public-api/v3

# Bling ERP (Fornecedor)
BLING_API_TOKEN=
BLING_API_URL=https://api.bling.com.br/Api/v3

# Email — Resend
RESEND_API_KEY=
EMAIL_FROM=crm@adds.com.br

# Storage
NEXT_PUBLIC_STORAGE_BUCKET=adds-crm
