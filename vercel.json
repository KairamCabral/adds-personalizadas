{
  "framework": "nextjs",
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "crons": [
    {
      "path": "/api/cron/tiny-sync-incremental",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/cron/tiny-refresh-token",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/push/send",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/nps-dispatch",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/meta-capi-dispatch",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/congress-sync",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/congress-dispatch",
      "schedule": "0 8 * * *"
    }
  ]
}
